import { Component, OnInit } from '@angular/core';
import { AttendeeService } from '../services/attendee.service';
import { EventService } from '../services/event.service';
import { Attendee } from '../../models/attendee.model';
import { Event } from '../../models/event.model';

@Component({
  selector: 'app-organizer',
  templateUrl: './organizer.component.html',
  styleUrls: ['./organizer.component.css']
})
export class OrganizerComponent implements OnInit {
  attendees: Attendee[] = [];
  unassignedAttendees: any[] = [];
  events: Event[] = [];

  constructor(
    private attendeeService: AttendeeService,
    private eventService: EventService
  ) {}

  ngOnInit(): void {
    this.getEvents();
    this.getAttendees();
  }

  getAttendees(): void {
    this.attendeeService.getAttendees().subscribe({
      next: (attendees) => {
        this.attendees = attendees;
        this.unassignedAttendees = this.attendees
          .filter(a => !a.EventId)
          .map(a => ({ ...a, selectedEventId: '' }));
      },
      error: (err) => {
        console.error('Failed to fetch attendees', err);
      }
    });
  }

  getEvents(): void {
    this.eventService.getEvents().subscribe({
      next: (events) => {
        this.events = events;
      },
      error: (err) => {
        console.error('Failed to fetch events', err);
      }
    });
  }

  getEventAttendees(eventId: number): Attendee[] {
    return this.attendees.filter(a => a.EventId === eventId);
  }

  assignAttendeeToEvent(attendee: Attendee, selectedEventId: number): void {
    const eventId = Number(selectedEventId);
    const event = this.events.find(e => e.EventId === eventId);

    if (!event) {
      console.error('Event not found');
      return;
    }

    // Update attendee with the selected event ID
    const updatedAttendee: Attendee = {
      ...attendee,
      EventId: eventId
    };
    // Remove the selectedEventId helper property
    delete (updatedAttendee as any).selectedEventId;

    // Update event budget (decrease by 500)
    const updatedEvent: Event = {
      ...event,
      Budget: event.Budget - 500
    };

    this.attendeeService.updateAttendee(attendee.AttendeeId!, updatedAttendee).subscribe({
      next: () => {
        this.eventService.updateEvent(event.EventId!, updatedEvent).subscribe({
          next: () => {
            this.getAttendees();
            this.getEvents();
          },
          error: (err) => {
            console.error('Failed to update event', err);
          }
        });
      },
      error: (err) => {
        console.error('Failed to update attendee', err);
      }
    });
  }

  releaseAttendeeFromEvent(attendee: Attendee, selectedEventId: number): void {
    const event = this.events.find(e => e.EventId === selectedEventId);

    if (!event) {
      console.error('Event not found');
      return;
    }

    // Set attendee's EventId to null
    const updatedAttendee: Attendee = {
      ...attendee,
      EventId: undefined
    };

    // Update event budget (increase by 500)
    const updatedEvent: Event = {
      ...event,
      Budget: event.Budget + 500
    };

    this.attendeeService.updateAttendee(attendee.AttendeeId!, updatedAttendee).subscribe({
      next: () => {
        this.eventService.updateEvent(event.EventId!, updatedEvent).subscribe({
          next: () => {
            this.getAttendees();
            this.getEvents();
          },
          error: (err) => {
            console.error('Failed to update event', err);
          }
        });
      },
      error: (err) => {
        console.error('Failed to release attendee', err);
      }
    });
  }
}
