<div class="organizer-container container mt-4">
    <h2 class="mb-4">Event Organizer</h2>
  
  <!-- Unassigned Attendees Section -->
  
  <div class="card mb-4">
      <div class="card-header">
        <h3>Unassigned Attendees</h3>
      </div>
      <div class="card-body">
        <div *ngIf="unassignedAttendees.length === 0" id="no_unassigned" class="alert alert-info">
          No Unassigned Attendees
        </div>
  
      <table *ngIf="unassignedAttendees.length > 0" class="table table-striped table-bordered"><thead class="thead-dark">
            <tr>
              <th>Name</th>
              <th>Age</th>
              <th>Email</th>
              <th>Event</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <tr *ngFor="let attendee of unassignedAttendees">
              <td>{{ attendee.Name }}</td>
              <td>{{ attendee.Age }}</td>
              <td>{{ attendee.Email }}</td>
              <td>
                <select class="form-control" [(ngModel)]="attendee.selectedEventId">
                  <option value="" disabled selected>Select Event</option>
                  <option *ngFor="let event of events" [value]="event.EventId">
                    {{ event.Name }}
                  </option>
                </select>
              </td>
              <td>
                <button class="btn btn-primary btn-sm"
                  (click)="assignAttendeeToEvent(attendee, attendee.selectedEventId)"
                  [disabled]="!attendee.selectedEventId">
                  Assign to Event
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
  
  </div>
  
  <!-- Events with Attendees Section -->
  
  <div class="card">
      <div class="card-header">
        <h3>Events with Attendees</h3>
      </div>
      <div class="card-body">
        <div *ngIf="events.length === 0" id="no_events" class="alert alert-info">
          No Events Available
        </div>
  
      <div *ngIf="events.length > 0"><table class="table table-striped table-bordered">
            <thead class="thead-dark">
              <tr>
                <th>Event Name</th>
                <th>Budget</th>
                <th>Attendees</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let event of events">
                <td>{{ event.Name }}</td>
                <td>{{ event.Budget }}</td>
                <td>
                  <table class="table table-sm table-bordered mb-0" *ngIf="getEventAttendees(event.EventId!).length > 0">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Email</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr *ngFor="let attendee of getEventAttendees(event.EventId!)">
                        <td>{{ attendee.Name }}</td>
                        <td>{{ attendee.Age }}</td>
                        <td>{{ attendee.Email }}</td>
                        <td>
                          <button class="btn btn-danger btn-sm"
                            (click)="releaseAttendeeFromEvent(attendee, event.EventId!)">
                            Release Attendee
                          </button>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <span *ngIf="getEventAttendees(event.EventId!).length === 0" class="text-muted">
                    No attendees assigned</span>
                
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
  
  </div>
  </div>

